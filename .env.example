CODE:
# --- Application ---
APP_NAME="FinOps Optimization Agent"
ENV=development
LOG_LEVEL=INFO

# --- Database ---
# SQLite by default for zero-config local runs. Swap for a Postgres URL in production,
# e.g. postgresql+psycopg2://user:password@localhost:5432/finops
DATABASE_URL=sqlite:///./finops.db

# --- LLM Provider ---
# One of: anthropic | openai | none
# "none" forces the deterministic rule-based policy engine (no external API calls),
# which keeps the project fully reproducible without secrets.
LLM_PROVIDER=none
ANTHROPIC_API_KEY=your_api_key_here
OPENAI_API_KEY=your_api_key_here
LLM_MODEL=claude-3-5-sonnet-20241022

# --- FinOps Policy ---
UNDERUTILIZED_CPU_THRESHOLD=15.0
FORECAST_HORIZON_HOURS=168
HISTORY_LOOKBACK_DAYS=14
DRY_RUN_DEFAULT=true

# --- Bootstrap ---
AUTO_SEED=true
CORS_ORIGINS=*

